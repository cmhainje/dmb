Bootstrap: docker
From: ubuntu:22.04

%labels
    Author Connor Hainje
    Description GIZMO simulation container with OpenMPI 4.1.6 for HPC clusters

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y \
        build-essential \
        cmake \
        gfortran \
        pkg-config \
        wget \
        curl \
        git \
        vim \
        gdb \
        valgrind \
        ca-certificates \
        libgsl-dev \
        zlib1g-dev \
        libnuma-dev \
        libpmix-dev \
        libhwloc-dev \
        libevent-dev

    rm -rf /var/lib/apt/lists/*

    mkdir -p /build && cd /build

    #----------------------------------------------
    # OpenMPI 4.1.6
    #----------------------------------------------
    wget https://download.open-mpi.org/release/open-mpi/v4.1/openmpi-4.1.6.tar.gz
    tar xzf openmpi-4.1.6.tar.gz
    cd openmpi-4.1.6
    ./configure --prefix=/opt/openmpi \
        --with-pmix \
        --with-hwloc \
        --with-libevent \
        --enable-mpi-fortran \
        --enable-shared
    make -j$(nproc)
    make install
    cd /build
    rm -rf openmpi-4.1.6*

    export PATH=/opt/openmpi/bin:$PATH
    export LD_LIBRARY_PATH=/opt/openmpi/lib:$LD_LIBRARY_PATH
    export CC=mpicc
    export CXX=mpicxx
    export FC=mpifort

    #----------------------------------------------
    # FFTW 3.3.10 with MPI support
    #----------------------------------------------
    wget https://www.fftw.org/fftw-3.3.10.tar.gz
    tar xzf fftw-3.3.10.tar.gz
    cd fftw-3.3.10

    ./configure --prefix=/opt/fftw3 \
        --enable-mpi \
        --enable-openmp \
        --enable-threads \
        --enable-shared
    make -j$(nproc)
    make install

    make clean
    ./configure --prefix=/opt/fftw3 \
        --enable-mpi \
        --enable-openmp \
        --enable-threads \
        --enable-shared \
        --enable-float
    make -j$(nproc)
    make install

    cd /build
    rm -rf fftw-3.3.10*

    #----------------------------------------------
    # HDF5 1.14.3 with MPI support
    #----------------------------------------------
    wget https://github.com/HDFGroup/hdf5/releases/download/hdf5_1.14.3/hdf5-1.14.3.tar.gz
    tar xzf hdf5-1.14.3.tar.gz
    cd hdf5-1.14.3
    ./configure --prefix=/opt/hdf5 \
        --enable-parallel \
        --enable-shared \
        --enable-build-mode=production
    make -j$(nproc)
    make install
    cd /build
    rm -rf hdf5-1.14.3*

    cd /
    rm -rf /build

%environment
    export PATH=/opt/openmpi/bin:$PATH
    export LD_LIBRARY_PATH=/opt/openmpi/lib:$LD_LIBRARY_PATH
    export MANPATH=/opt/openmpi/share/man:$MANPATH

    export PATH=/opt/fftw3/bin:$PATH
    export LD_LIBRARY_PATH=/opt/fftw3/lib:$LD_LIBRARY_PATH
    export CPATH=/opt/fftw3/include:$CPATH
    export PKG_CONFIG_PATH=/opt/fftw3/lib/pkgconfig:$PKG_CONFIG_PATH

    export PATH=/opt/hdf5/bin:$PATH
    export LD_LIBRARY_PATH=/opt/hdf5/lib:$LD_LIBRARY_PATH
    export HDF5_DIR=/opt/hdf5
    export CPATH=/opt/hdf5/include:$CPATH
    export PKG_CONFIG_PATH=/opt/hdf5/lib/pkgconfig:$PKG_CONFIG_PATH

    export OMPI_ALLOW_RUN_AS_ROOT=1
    export OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1

%runscript
    exec /bin/bash "$@"

%help
    GIZMO simulation container with OpenMPI 4.1.6

    Build the container:
        apptainer build gizmo.sif gizmo.def

    Interactive shell:
        apptainer shell gizmo.sif

    Compile GIZMO (bind your source directory):
        apptainer exec --bind /path/to/gizmo:/workspace gizmo.sif bash -c "cd /workspace && make"

    Run with MPI (use host's mpirun):
        mpirun -np 4 apptainer exec --bind /path/to/data:/data gizmo.sif /path/to/GIZMO /data/param.file

    On SLURM clusters:
        srun apptainer exec --bind $PWD:/workspace gizmo.sif /workspace/GIZMO /workspace/param.file
